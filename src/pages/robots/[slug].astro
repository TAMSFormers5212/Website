---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = (async () => {
  const robots = await getCollection('robots');
  return robots.map((robot) => ({ params: { slug: robot.id }, props: { robot } }));
}) satisfies GetStaticPaths;

const { robot } = Astro.props;
const { Content } = await render(robot);
---

<Base
  title={`${robot.data.name} (${robot.data.year}) | TAMSformers`}
  description={robot.data.summary}
>
  <main id="main">
    <section class="inner-page portfolio-details">
      <div class="container">
        <div class="section-title">
          <h2>{robot.data.name}</h2>
          {/* Entries named after their season would otherwise repeat themselves. */}
          {robot.data.name !== `${robot.data.year} Robot` && <p>{robot.data.year} Robot</p>}
        </div>

        <div class="row gy-4">
          <div class="col-lg-8">
            <div class="row gy-3">
              {
                robot.data.images.map((image, index) => (
                  <div class="col-md-6">
                    <a
                      href={image.src}
                      class="portfolio-lightbox"
                      data-gallery={`robot-${robot.id}`}
                      title={`${robot.data.name} — photo ${index + 1}`}
                    >
                      <Image
                        src={image}
                        alt={`${robot.data.name}, photo ${index + 1} of ${robot.data.images.length}`}
                        width={600}
                        class="img-fluid"
                        loading={index === 0 ? 'eager' : 'lazy'}
                      />
                    </a>
                  </div>
                ))
              }
            </div>
          </div>

          <div class="col-lg-4">
            <div class="portfolio-info">
              <h3>Overview</h3>
              <p>{robot.data.summary}</p>
            </div>
          </div>
        </div>

        {
          robot.data.mechanisms.length > 0 && (
            <div class="row mt-4">
              <div class="col-12">
                <h3>Mechanisms</h3>
                {robot.data.mechanisms.map((mechanism) => (
                  <div class="mb-3">
                    <h4>{mechanism.title}</h4>
                    <p>{mechanism.body}</p>
                  </div>
                ))}
              </div>
            </div>
          )
        }

        <div class="row mt-4">
          <div class="col-12">
            <Content />
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>
