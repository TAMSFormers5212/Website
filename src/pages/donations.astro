---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import type { NavLink } from '../lib/nav';
import sponsorInfo from '../assets/img/sponsor-info.png';

const navLinks: NavLink[] = [
  { label: 'Sponsorship Tiers', href: '#tiers' },
  { label: 'Why Sponsor Us?', href: '#why-sponsor' },
  { label: 'Back to Home', href: url('/') },
];

const detailsDoc =
  'https://docs.google.com/document/d/10j5uqoAWN2g2Ksszawrct1-dpI4DrzXAJVO0XPR2K5U/edit?usp=sharing';

const tiers = [
  {
    name: 'Bronze-Level Sponsor',
    amount: '100+',
    benefits: ['Name/Logo on Team website', 'Name/Logo on General media'],
  },
  {
    name: 'Silver-Level Sponsor',
    amount: '500+',
    benefits: ['All Bronze-Level Benefits', 'Placement on Team T-shirts', 'Logo on Competition robot'],
  },
  {
    name: 'Gold-Level Sponsor',
    amount: '1000+',
    benefits: [
      'All Silver-Level Benefits',
      'Prominent featuring on Team T-Shirt and Robot',
      'Thank you plaque at the end of each season',
    ],
  },
  {
    name: 'Diamond-Level Sponsor',
    amount: '2000+',
    benefits: [
      'All Gold-Level Benefits',
      'Logos displayed prominently in our workspace and competition pit',
      'Full support at any STEM related outreach programs or events',
      'Optional robot demo at company',
    ],
  },
];

const custom = {
  name: 'Custom Sponsorship',
  note: 'Any amount, or in-kind support',
  benefits: [
    'Benefits tailored to your contribution',
    'In-kind donations welcome (parts, tooling, services)',
    "Get in touch and we'll work something out",
  ],
};
---

<Base
  title="Donations | TAMSformers"
  description="Support TAMSformers Robotics Team 5212 through our sponsorship tiers."
  navLinks={navLinks}
  navCta={{ label: 'Donate', href: '#tiers' }}
  heading="Sponsor TAMSformers"
  intro="TAMSformers is a high school FRC robotics team based in Denton, TX. We build competitive robots, mentor younger students, and inspire the next generation of engineers. Your sponsorship directly funds robot parts, competition entry fees, travel, and STEM outreach programs in our community."
>
  <main id="main">
    <section id="tiers" class="pricing">
      <div class="container">
        <div class="section-title" data-aos="fade-up">
          <h2>Sponsorship Tiers</h2>
          <p>
            Each tier comes with increasing visibility and engagement benefits. Choose the tier that fits your
            organization best.
          </p>
        </div>

        <div class="row g-4 justify-content-center">
          {
            tiers.map((tier, index) => (
              <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay={100 * index}>
                <div class="tier panel">
                  <h3>{tier.name}</h3>
                  <div class="price">
                    <sup>$</sup>{tier.amount}
                    <span>per month</span>
                  </div>
                  <ul>
                    {tier.benefits.map((benefit) => (
                      <li>
                        <Icon name="bx:check" /> {benefit}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ))
          }
          <div class="col-lg-10" data-aos="fade-up" data-aos-delay="200">
            <div class="tier custom panel">
              <h3>{custom.name}</h3>
              <div class="price">{custom.note}</div>
              <ul>
                {
                  custom.benefits.map((benefit) => (
                    <li>
                      <Icon name="bx:check" /> {benefit}
                    </li>
                  ))
                }
              </ul>
              <a href={url('/#contact')} class="button ghost">Contact Us</a>
            </div>
          </div>
        </div>

        <div class="text-center mt-5" data-aos="fade-up">
          <a href={detailsDoc} target="_blank" rel="noopener" class="button primary">More Details</a>
        </div>
      </div>
    </section>

    <section id="why-sponsor" class="why-sponsor section-dark">
      <div class="container">
        <div class="section-title" data-aos="fade-up"><h2>Why Sponsor Us?</h2></div>

        <div class="row align-items-center gy-4">
          <div class="col-lg-5" data-aos="fade-up">
            <div class="panel">
              <Image
                src={sponsorInfo}
                alt="Sponsorship information: donation levels and the benefits included at each level"
                loading="lazy"
              />
            </div>
          </div>
          <div class="col-lg-7" data-aos="fade-up" data-aos-delay="100">
            <p>
              TAMSformers is the only robotics team in Denton county, and we strive to represent the North Texas
              region with the best possible robot every year. Our very talented team members dedicate months preparing
              for the season, but recently we have had less money for parts and tools that can make our robot the best
              possible. We hope you will make a contribution towards our cause, all proceeds go directly to us through
              the UNT Foundation.
            </p>
            <p class="mt-4"><a href={detailsDoc} target="_blank" rel="noopener" class="button light">Full sponsorship document</a></p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>
